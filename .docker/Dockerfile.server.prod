# Production server image — Spring Boot's layered jar format, extracted into
# image layers ordered by change frequency (dependencies change least, app
# code most) for fast rebuilds and cold starts. Build context: repo root.
FROM maven:3.9-eclipse-temurin-25 AS build
WORKDIR /srv
# -DskipTests: CI runs the suite; image builds stay fast.
COPY server/ ./
RUN mvn -q -DskipTests package \
 && java -Djarmode=tools -jar target/*.jar extract --layers --destination target/extracted

FROM eclipse-temurin:25-jre-noble
WORKDIR /app
# Healthcheck probe binary: the JRE base ships neither curl nor wget, and the
# prod app stack's compose healthcheck needs one — a small layer, cached
# across builds like every other base-image addition.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*
# Layer order matters: least-changed first. The extracted layout is launched
# by the Boot loader's main class from the merged /app directory.
COPY --from=build /srv/target/extracted/dependencies/ ./
COPY --from=build /srv/target/extracted/spring-boot-loader/ ./
COPY --from=build /srv/target/extracted/snapshot-dependencies/ ./
COPY --from=build /srv/target/extracted/application/ ./
EXPOSE 8080
ENTRYPOINT ["java", "org.springframework.boot.loader.launch.JarLauncher"]
# Boot 4.1's layered-extract layout is a THIN app jar (its own Main-Class,
# Class-Path pointing at the sibling lib/ directory) with an EMPTY loader
# directory — JarLauncher above no longer exists in the extracted tree, so
# this later ENTRYPOINT (the last one wins) launches the thin jar directly.
# The glob keeps working when the pom version moves; exec keeps signals
# (docker stop → SIGTERM) flowing to the JVM, not the shell.
ENTRYPOINT ["/bin/sh", "-c", "exec java -jar server-*.jar"]
