# Maven build output (any depth — server/target/)
target/
# JS installs & build output
node_modules/
dist/
# Env files stay out of git — EXCEPT the two committed non-secrets: the
# placeholder template the deploy materializes the real file from, and the
# single non-sensitive compose interpolation variable (IMAGE_TAG=ci).
# Negations must come after the rule; the parent dirs are not excluded, so
# re-including files under them works.
.env*
!server/.env.production.example
!.docker/.env
# Test coverage (JaCoCo / Vitest HTML reports)
coverage/
# Topic 26 (files-media): the file store's runtime home — uploaded bytes and
# metadata sidecars are runtime data, never source (server/data/files/, plus
# the throwaway store the tests point the storage-dir property at).
server/data/
*.log
# OS
.DS_Store
# IDE dirs
.idea/
*.iml
.vscode/
# In-container flock targets for verification runs (runtime artifacts)
.verify.lock
# Playwright e2e artifacts (host-run suite in e2e/ — reports + browser cache)
e2e/test-results/
e2e/playwright-report/
e2e/.playwright/
.zcode/
